# Copy to .env.local (git-ignored) for local development, and set the same
# variable in the Vercel project settings for production.

# Optional. GitHub personal access token used server-side by lib/github.ts to read
# pinned repositories and the contribution calendar (public data only).
#
# Create a FINE-GRAINED token with no extra permissions:
#   GitHub -> Settings -> Developer settings -> Personal access tokens -> Fine-grained tokens
#   Repository access: "Public repositories (read-only)", no account permissions.
#
# Without it the GitHub section shows the featured projects and an "unavailable"
# notice — the site never displays placeholder activity.
GITHUB_PAT=
